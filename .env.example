APP_ENV=local
APP_PORT=4000

FRONTEND_URL=http://localhost:3000

# DATABASE
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_database_password
DB_NAME=k2-manual
DB_SSL=false
DB_SSL_CA=
DEBUG=FALSE

# JWT
ACCESS_TOKEN_EXPIRE=2-h
PC_REFRESH_TOKEN_EXPIRE=6-h
MOBILE_REFRESH_TOKEN_EXPIRE=1-M
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=

# Mail
MAIL_USER=your_email@example.com
MAIL_PASSWORD=your_mail_app_password
MAIL_FROM='"K2 Manual" <your_email@example.com>'

# File
STORAGE_PATH=/storage
FILE_URL_PREFIX=http://localhost:4000/files/
